{
  "name": "woku-app",
  "version": "1.0.10",
  "description": "Desktop application for managing shared subscription accounts",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "clear-cache": "node clear-cache.js",
    "fresh-start": "node clear-cache.js && electron .",
    "fresh-dev": "node clear-cache.js && electron . --dev",
    "prepack": "echo '👉 Preparing build...' && exit 0",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "electron",
    "account-manager",
    "subscription-manager"
  ],
  "author": { "name": "WokuShop", "email": "wokushop@example.com" },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/Osiurs/WokuShop.git"
  },
  "devDependencies": {
    "electron": "^30.0.0-castlabs.1",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "archiver": "^6.0.1",
    "axios": "^1.6.2",
    "electron-log": "^5.1.5",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.2.1",
    "form-data": "^4.0.0",
    "node-machine-id": "^1.1.12",
    "unzipper": "^0.10.14"
  },
  "build": {
    "appId": "com.wokushop.wokuapp",
    "productName": "Woku App",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "config/**/*",
      "extensions/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "extensions",
        "to": "extensions",
        "filter": ["**/*"]
      }
    ],
    "asarUnpack": [
      "**/extensions/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src/assets/images/logo.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "src/assets/images/logo.icns",
      "identity": null,
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "src/assets/images/logo.png",
      "category": "Utility",
      "maintainer": "WokuShop <wokushop@example.com>"
    },
    "publish": {
      "provider": "github",
      "owner": "Osiurs",
      "repo": "WokuShop"
    }
  }
}
